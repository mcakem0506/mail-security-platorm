# Mail Security Platform — example configuration.
# Copy to .env and adjust. NEVER put secrets here: values marked *_FILE point at files managed
# by Docker secrets or a Vault-compatible store (ТЗ 28).

# ---------------------------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------------------------
MSP_ENVIRONMENT=production
MSP_DEBUG=false
MSP_PUBLIC_BASE_URL=https://mail-security.corp.example
HTTP_PORT=8080
HTTPS_PORT=8443
API_WORKERS=2
WORKER_MAIL_CONCURRENCY=2
WORKER_TI_CONCURRENCY=4

# ---------------------------------------------------------------------------------------------
# Organisation
# ---------------------------------------------------------------------------------------------
MSP_ORGANIZATION_NAME=Название организации
# Comma-separated corporate domains. Lookalike detection compares against these.
MSP_CORPORATE_DOMAINS=corp.example,corp.local
# Domains of legitimate bulk/relay infrastructure whose Return-Path differs from From.
MSP_TRUSTED_INFRASTRUCTURE_DOMAINS=
# Mail gateways the organisation operates itself: ksmg, eop, spamassassin, virus_scanner.
# Their verdict headers are read as an additional signal: a detection raises risk, a clean
# verdict never lowers it. A gateway that is NOT listed here is ignored, because any sender
# can forge an "already scanned" header. For Kaspersky Secure Mail Gateway use: ksmg
MSP_TRUSTED_GATEWAYS=

# ---------------------------------------------------------------------------------------------
# Database, cache, object storage
# ---------------------------------------------------------------------------------------------
POSTGRES_USER=msp
POSTGRES_DB=msp
# Required; set a strong value before the first start.
POSTGRES_PASSWORD=
REDIS_MAXMEMORY=512mb
MINIO_ROOT_USER=msp
MSP_OBJECT_STORAGE_BUCKET=msp-content
MSP_OBJECT_STORAGE_BACKEND=filesystem
MSP_OBJECT_STORAGE_SECURE=false

# ---------------------------------------------------------------------------------------------
# Authentication and sessions (ТЗ 24)
# ---------------------------------------------------------------------------------------------
MSP_SECRET_KEY_FILE=/run/secrets/msp_secret_key
MSP_AUTH_BACKEND=local
MSP_COOKIE_SECURE=true
MSP_SESSION_TTL_MINUTES=60
MSP_SESSION_IDLE_MINUTES=20
MSP_PRIVILEGED_SESSION_TTL_MINUTES=30
MSP_REQUIRE_MFA_FOR_PRIVILEGED=true
MSP_MAX_FAILED_LOGINS=5
MSP_LOCKOUT_MINUTES=15
# The first administrator created by scripts/bootstrap.py
MSP_BOOTSTRAP_ADMIN_EMAIL=security-admin@corp.example

# ---------------------------------------------------------------------------------------------
# Analysis limits (ТЗ 8.2, ТЗ 1.0.1 4.2)
#
# Each limit is separately configurable, and exceeding any of them produces its own explainable
# signal plus an entry in missing_evidence — so a message that was only partly examined can never
# be reported as one that was found clean.
#
# A message over MSP_LIMIT_MESSAGE_SIZE is not analysed at all. It is deliberately NOT truncated:
# analysing the first N bytes and presenting the result as a check is worse than an honest refusal.
# ---------------------------------------------------------------------------------------------
MSP_LIMIT_MESSAGE_SIZE=26214400
MSP_LIMIT_ATTACHMENT_SIZE=20971520
MSP_LIMIT_ATTACHMENT_COUNT=50
MSP_LIMIT_MIME_PARTS=300
MSP_LIMIT_MIME_DEPTH=12
MSP_LIMIT_ARCHIVE_DEPTH=3
MSP_LIMIT_DECOMPRESSED_TOTAL=104857600
MSP_LIMIT_DECOMPRESSED_FILE=26214400
MSP_LIMIT_URL_COUNT=500
MSP_LIMIT_PARSE_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------------------------------------
# Mail flow topology (ТЗ 1.0.1 4.3, 4.4)
#
# Naming a gateway in MSP_TRUSTED_GATEWAYS is necessary but not sufficient. Since 1.0.1 a
# gateway's headers are believed only when the Received chain proves the message actually passed
# that hop, which is configured per gateway in the console (Settings -> Mail Gateways) and stored
# as TrustedMailHop records. A gateway with no hop has its headers shown to the analyst and
# ignored by the risk engine.
# ---------------------------------------------------------------------------------------------
# Networks belonging to the organisation, used to find the hop where a message entered.
MSP_INTERNAL_MAIL_NETWORKS=
# Authentication servers whose Authentication-Results may be read, in addition to the ones
# derived from the configured hops. With nothing configured anywhere, every header is read and
# the missing allowlist is reported as a readiness warning rather than silently weakening
# detection. Once something is configured, a header claiming to come from one of *these* servers
# on a path that does not include them is treated as tampering.
MSP_TRUSTED_AUTHSERV_IDS=

# --- Gateway syslog intake (ТЗ 1.0.2 20) ---
# Plain syslog has no authentication at all, so intake fails closed: with no allowed sources,
# nothing is accepted. TCP or TLS is required in production; UDP is refused there.
MSP_GATEWAY_SYSLOG_ENABLED=false
# Loopback by default. Set this deliberately when events arrive from another host.
MSP_GATEWAY_SYSLOG_HOST=127.0.0.1
MSP_GATEWAY_SYSLOG_PORT=6514
MSP_GATEWAY_SYSLOG_TRANSPORT=tls
# Comma-separated addresses or CIDR networks of the gateway nodes. Required when enabled.
MSP_GATEWAY_SYSLOG_ALLOWED_SOURCES=
# MSP_GATEWAY_SYSLOG_TLS_CERTFILE=/etc/ssl/certs/syslog.pem
# MSP_GATEWAY_SYSLOG_TLS_KEYFILE=/run/secrets/syslog_key
# Client certificates give the source an identity an IP allowlist cannot.
# MSP_GATEWAY_SYSLOG_TLS_CLIENT_CA=/etc/ssl/certs/internal-ca.pem

# ---------------------------------------------------------------------------------------------
# Detection thresholds (ТЗ 17.1)
# ---------------------------------------------------------------------------------------------
MSP_SUSPICIOUS_THRESHOLD=25
MSP_HIGH_RISK_THRESHOLD=50
MSP_MALICIOUS_THRESHOLD=80

# ---------------------------------------------------------------------------------------------
# VirusTotal (ТЗ 14). "public" is not a supported production mode.
# disabled | mock | premium | private_scanning
# ---------------------------------------------------------------------------------------------
MSP_VT_MODE=disabled
# MSP_VT_API_KEY_FILE=/run/secrets/vt_api_key
MSP_VT_PER_MINUTE_LIMIT=300
MSP_VT_PER_DAY_LIMIT=50000
MSP_VT_TIMEOUT_SECONDS=8
# File upload stays disabled in v1 and requires VT_MODE=private_scanning even then (ТЗ 14.5).
MSP_VT_ALLOW_FILE_UPLOAD=false

# ---------------------------------------------------------------------------------------------
# Threat Intelligence privacy policy (ТЗ 2.4)
# Defaults send only hashes, domains and IPs. Full URLs often carry tokens and recipient
# identifiers, so enabling them is an explicit decision.
# ---------------------------------------------------------------------------------------------
MSP_TI_ALLOW_HASH=true
MSP_TI_ALLOW_DOMAIN=true
MSP_TI_ALLOW_IP=true
MSP_TI_ALLOW_URL=false
MSP_TI_ALLOW_URL_PATH=false
MSP_TI_ALLOW_SENDER_EMAIL=false
MSP_TI_ALLOW_INTERNAL_DOMAINS=false
MSP_TI_TIMEOUT_SECONDS=6

# ---------------------------------------------------------------------------------------------
# Local scanner (ТЗ 12.3). Supplementary only — not enterprise malware protection.
# Start with: docker compose --profile clamav up -d
# ---------------------------------------------------------------------------------------------
MSP_CLAMAV_ENABLED=false
MSP_CLAMAV_HOST=clamav
MSP_CLAMAV_PORT=3310

# ---------------------------------------------------------------------------------------------
# Exchange integration (ТЗ 7). mock | security_mailbox | ews
# ---------------------------------------------------------------------------------------------
MSP_EXCHANGE_PROVIDER=mock
MSP_SECURITY_MAILBOX_HOST=
MSP_SECURITY_MAILBOX_PORT=993
MSP_SECURITY_MAILBOX_USER=security-phishing@corp.example
# MSP_SECURITY_MAILBOX_PASSWORD_FILE=/run/secrets/security_mailbox_password
MSP_SECURITY_MAILBOX_FOLDER=INBOX
MSP_SECURITY_MAILBOX_SSL=true
# MSP_SECURITY_MAILBOX_CA_FILE=/etc/ssl/certs/internal-ca.pem

# EWS: a universal adapter. The endpoint comes from Autodiscover unless one is set explicitly,
# the authentication method is negotiated from the preference list, and the Exchange version is
# detected rather than declared (2016 and 2019 are equivalent to this module).
# Verify what a deployment actually supports with: python scripts/probe_exchange.py
MSP_EWS_AUTODISCOVER=true
MSP_EWS_PRIMARY_SMTP_ADDRESS=
MSP_EWS_ENDPOINT=
MSP_EWS_USERNAME=
# MSP_EWS_PASSWORD_FILE=/run/secrets/ews_password
# auto | ntlm | kerberos | basic | sspi
MSP_EWS_AUTH_METHOD=auto
# Kerberos first: it authenticates without putting a reusable credential on the wire. Basic is
# deliberately absent, and a silent downgrade to it is refused — enabling Basic takes both
# MSP_EWS_ALLOW_BASIC_AUTH=true and an explicit place in this list (ТЗ 1.0.1 4.5).
MSP_EWS_AUTH_PREFERENCE=kerberos,ntlm
# With Basic enabled the service account password is sent on every request. It then requires
# HTTPS and TLS verification, the connection is recorded in the audit trail, and production
# readiness stays "degraded" until the choice is approved separately.
MSP_EWS_ALLOW_BASIC_AUTH=false
# impersonation reaches any mailbox in scope; delegate only explicitly shared ones.
MSP_EWS_ACCESS_MODE=delegate
MSP_EWS_VERIFY_TLS=true
MSP_EWS_TIMEOUT_SECONDS=30
# Mailboxes this deployment may touch: addresses or "@domain", comma separated. Empty means the
# service account's own mailbox only. Enabling remediation without a scope is refused, because an
# unscoped deployment could act on any mailbox in the organisation.
MSP_EWS_MAILBOX_SCOPE=
MSP_EWS_QUARANTINE_FOLDER=MSP Quarantine

# Remediation is disabled and dry-run-only by default (ТЗ 2.5, 7.1).
MSP_REMEDIATION_ENABLED=false
MSP_REMEDIATION_DRY_RUN_ONLY=true
MSP_REMEDIATION_SECOND_APPROVER_THRESHOLD=10

# ---------------------------------------------------------------------------------------------
# Active Directory (ТЗ 10, 24) — always read-only: this code has no directory write operations.
#
# Two independent uses:
#   MSP_AD_ENABLED=true      — sync the directory for protected identities
#   MSP_AUTH_BACKEND=ldap    — authenticate platform users against AD
# ---------------------------------------------------------------------------------------------
MSP_AD_ENABLED=false
MSP_AD_SERVER=
MSP_AD_PORT=636
MSP_AD_USE_SSL=true
MSP_AD_START_TLS=false
# Keep verification on. Without an internal CA, export the domain controller certificate and
# point MSP_AD_CA_FILE at it instead of disabling this: a user password travels over this link.
MSP_AD_VERIFY_TLS=true
MSP_AD_TIMEOUT_SECONDS=10
MSP_AD_BIND_DN=
# MSP_AD_BIND_PASSWORD_FILE=/run/secrets/ad_bind_password
# Left empty, the base DN is discovered from RootDSE, so no directory layout is assumed.
MSP_AD_BASE_DN=
# MSP_AD_CA_FILE=/etc/ssl/certs/internal-ca.pem
MSP_AD_SYNC_INTERVAL_MINUTES=360
MSP_AD_INCLUDE_OPTIONAL_ATTRIBUTES=false

# --- AD authentication (used when MSP_AUTH_BACKEND=ldap) ---
# The login filter accepts mail, userPrincipalName or sAMAccountName by default; override it
# only if the directory uses a different attribute for login.
# MSP_AD_USER_FILTER=(&(objectCategory=person)(objectClass=user)(|(mail={login})(userPrincipalName={login})(sAMAccountName={login})))
# Binds directly as the user, without a service account. Useful where no service account exists:
# MSP_AD_USER_PRINCIPAL_TEMPLATE={login}
# AD group -> platform role. The first match wins, so list the most privileged group first.
# A group may be written as a full DN or as a bare CN, for example:
#   MSP_AD_GROUP_ROLE_MAP=SOC Admins=security_admin;SOC Analysts=security_analyst
MSP_AD_GROUP_ROLE_MAP=
# Role for a user whose groups match nothing above.
MSP_AD_DEFAULT_ROLE=employee
# true = refuse users with no mapped group instead of granting the default role.
MSP_AD_REQUIRE_GROUP_MATCH=false

# --- Protected identities from directory groups (ТЗ 1.0.1 5) ---
# Group -> category[:risk_class][:vip]; semicolon separated. The group may be a full DN or a bare
# CN. Membership decides who is protected, so the list does not go stale the week after it is
# written. Categories: executive, finance, hr, administrator, security, procurement, vip.
# Risk classes: critical, high, medium, low — weighted separately from the category, because a
# finance clerk and the CFO share a category but not a blast radius.
#   MSP_AD_PROTECTED_GROUPS=CN=Executives,OU=Groups,DC=corp,DC=example=executive:critical:vip;Finance=finance:high;SOC=security:high
MSP_AD_PROTECTED_GROUPS=
# Local accounts that may still sign in while MSP_AUTH_BACKEND=ldap, so a directory outage cannot
# lock the security team out of their own console. Every such sign-in is audited as a break-glass
# event. Leaving this empty does not disable local accounts — it only means their use is not
# recognised as expected.
MSP_EMERGENCY_LOCAL_ACCOUNTS=

# ---------------------------------------------------------------------------------------------
# Optional semantic analysis (ТЗ 16.4). Disabled by default; an external backend additionally
# requires an explicit DPA approval flag.
# ---------------------------------------------------------------------------------------------
MSP_SEMANTIC_ENABLED=false
MSP_SEMANTIC_BACKEND=disabled
MSP_SEMANTIC_EXTERNAL_DPA_APPROVED=false

# ---------------------------------------------------------------------------------------------
# URL resolution (ТЗ 11.4) — off by default, and only from an isolated egress zone.
# ---------------------------------------------------------------------------------------------
MSP_URL_FETCH_ENABLED=false
# MSP_URL_FETCH_PROXY=http://sandbox-proxy:3128

# ---------------------------------------------------------------------------------------------
# Retention in days (ТЗ 27). Confirm with the organisation before the pilot.
# ---------------------------------------------------------------------------------------------
MSP_RETENTION_METADATA_DAYS=180
MSP_RETENTION_ANALYSIS_DAYS=365
MSP_RETENTION_RAW_EML_DAYS=30
MSP_RETENTION_ATTACHMENT_DAYS=30
MSP_RETENTION_AUDIT_DAYS=400
MSP_RETENTION_MALICIOUS_SAMPLE_DAYS=365

# ---------------------------------------------------------------------------------------------
# Notifications (ТЗ 36)
# ---------------------------------------------------------------------------------------------
MSP_SMTP_HOST=
MSP_SMTP_PORT=25
MSP_SMTP_USE_TLS=true
MSP_SMTP_FROM=mail-security@corp.example
MSP_SECURITY_TEAM_EMAIL=soc@corp.example

# ---------------------------------------------------------------------------------------------
# Observability (ТЗ 31)
# ---------------------------------------------------------------------------------------------
MSP_LOG_LEVEL=INFO
MSP_LOG_FORMAT=json
MSP_METRICS_ENABLED=true
