# Shared image for the API and the workers.
FROM python:3.12-slim-bookworm AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# libmagic is not used (type detection is implemented in-process); only build essentials for
# wheels that have no manylinux build are installed, and they are removed afterwards.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml README.md ./
COPY packages ./packages
COPY providers ./providers
COPY apps/api ./apps/api
COPY apps/worker ./apps/worker
COPY scripts ./scripts

# The detection rule pack ships as data, not as part of the Python package (ТЗ 1.0.3 §12), so
# it can be reviewed and updated on its own schedule. The loader looks for /app/rules.
COPY rules ./rules
COPY datasets ./datasets

RUN pip install --no-cache-dir . \
    && apt-get purge -y --auto-remove build-essential \
    && rm -rf /root/.cache

# The application runs unprivileged and owns nothing it does not need to write.
RUN useradd --system --uid 10001 --home /app --shell /usr/sbin/nologin msp \
    && mkdir -p /var/lib/msp/content \
    && chown -R msp:msp /var/lib/msp /app

USER msp

EXPOSE 8000

CMD ["uvicorn", "msp_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
