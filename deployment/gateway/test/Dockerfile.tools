# Инструменты стенда: управляемый приёмник (двойник Exchange) и клиент для отправки писем.
# Только для проверки; в рабочую установку не входит.
FROM python:3.12-slim
RUN pip install --no-cache-dir "aiosmtpd>=1.4.6"
COPY deployment/gateway/test/fake_smtp.py /opt/fake_smtp.py
ENV PYTHONUNBUFFERED=1
CMD ["python", "/opt/fake_smtp.py"]
